{
  "name": "showup",
  "version": "4.6.110",
  "private": true,
  "description": "ShowUp \u2014 habits and workouts. A static PWA; this manifest exists only for the iOS shell.",
  "scripts": {
    "build:dist": "python3 tools/build-dist.py .",
    "check:dist": "node tools/check-dist.cjs .",
    "sync:ios": "npm run build:dist && npm run check:dist && npx cap sync ios",
    "open:ios": "npx cap open ios",
    "build:ota": "python3 tools/build-dist.py . && python3 tools/build-ota.py ."
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capgo/capacitor-updater": "^8.51.23"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
